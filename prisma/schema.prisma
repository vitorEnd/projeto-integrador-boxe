generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Experience {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}
enum Goal {
  EMAGRECIMENTO
  GANHO_MASSA
  CONDICIONAMENTO
  TECNICA
}
enum Category {
  AQUECIMENTO
  TECNICA
  CARDIO
  FORCA
  CORE
  MOBILIDADE
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("ALUNO")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  profile      Profile?
  sessions     Session[]
  workouts     Workout[]
  logs         WorkoutLog[]
  weightLogs   WeightLog[]
}

model Profile {
  id            Int        @id @default(autoincrement())
  userId        Int        @unique
  age           Int
  heightCm      Float
  weightKg      Float
  experience    Experience
  goal          Goal
  frequencyDays Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(64)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  description        String
  category           Category
  minExperienceLevel Experience
  goalTags           String
  createdAt          DateTime          @default(now())
  workouts           WorkoutExercise[]
}

model Workout {
  id            Int               @id @default(autoincrement())
  userId        Int
  goal          Goal
  experience    Experience
  frequencyDays Int
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises     WorkoutExercise[]
  logs          WorkoutLog[]
}

model WorkoutExercise {
  id              Int      @id @default(autoincrement())
  workoutId       Int
  exerciseId      Int
  order           Int
  sets            Int?
  reps            String?
  durationSeconds Int?
  restSeconds     Int
  notes           String?
  workout         Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise        Exercise @relation(fields: [exerciseId], references: [id])
  @@unique([workoutId, order])
}

model WorkoutLog {
  id              Int      @id @default(autoincrement())
  userId          Int
  workoutId       Int
  performedAt     DateTime
  durationMinutes Int
  perceivedEffort Int
  notes           String?  @db.VarChar(500)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout         Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

model WeightLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  weightKg   Float
  recordedOn DateTime @db.Date
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordedOn])
}
